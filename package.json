{
  "name": "kisan-sahyog",
  "version": "0.1.0",
  "description": "",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "vite",
    "build": "vite build --mode staging",
    "build:full": "node --env-file=.env scripts/build-search-index.mjs && vite build --mode staging && node --env-file=.env scripts/prerender.mjs && node --env-file=.env scripts/gen-sitemaps.mjs && node scripts/check-no-localhost-dist.mjs dist",
    "build:prod": "node --env-file=.env.production scripts/check-prod-env.mjs && node --env-file=.env.production scripts/build-search-index.mjs && node --env-file=.env.production node_modules/vite/bin/vite.js build --mode production && node --env-file=.env.production scripts/prerender.mjs && node --env-file=.env.production scripts/gen-sitemaps.mjs && node --env-file=.env.production scripts/check-prod-env.mjs --dist && node scripts/check-no-localhost-dist.mjs dist",
    "build:android": "node scripts/build-android.mjs",
    "android:debug": "node scripts/build-android.mjs --assemble",
    "android:debug:staging": "node scripts/build-android.mjs --target staging --assemble",
    "android:debug:staging-local": "node scripts/build-android.mjs --target staging --local-api --assemble",
    "android:release": "node scripts/build-android.mjs --release",
    "android:release:staging": "node scripts/build-android.mjs --target staging --release",
    "test:android": "bash scripts/test-android.sh",
    "preview": "vite preview",
    "lint": "eslint .",
    "db": "node --env-file=.env scripts/db.mjs",
    "check:dist:prod": "node --env-file=.env.production scripts/check-prod-env.mjs --dist",
    "db:prod:status": "node --env-file=.env.production scripts/check-prod-env.mjs && node --env-file=.env.production scripts/db.mjs status",
    "db:prod:migrate": "node --env-file=.env.production scripts/check-prod-env.mjs && node --env-file=.env.production scripts/db.mjs migrate",
    "seed": "node --env-file=.env scripts/seed.mjs",
    "refresh-prices": "node --env-file=.env scripts/refresh-data.mjs",
    "test:e2e": "node --env-file=.env node_modules/.bin/playwright test",
    "test:phase1": "node --env-file=.env scripts/test/phase1.mjs",
    "test:phase2": "node --env-file=.env scripts/test/phase2.mjs",
    "icons": "node scripts/gen-icons.mjs",
    "morning": "node --env-file-if-exists=.env scripts/morning/run.mjs",
    "morning:poll": "node scripts/morning/poll-result.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Himanshu1305/Kissansahyog.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/Himanshu1305/Kissansahyog/issues"
  },
  "homepage": "https://github.com/Himanshu1305/Kissansahyog#readme",
  "private": "true",
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/network": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@supabase/supabase-js": "^2.112.3",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.3",
    "@fontsource/noto-sans-devanagari": "^5.3.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.0",
    "astronomy-engine": "^2.1.19",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.3",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0"
  }
}
