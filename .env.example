# Kisan Sahyog — environment variables
# Copy this file to `.env` and fill in real values. `.env` is gitignored; never commit real secrets.

# --- Client-side (exposed to the browser via Vite; safe = anon key only) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Server-side / tooling only (NEVER import into client code) ---
# Used by seed scripts (scripts/seed.mjs) to bypass RLS for one-time lookup-table seeding.
SUPABASE_SERVICE_ROLE_KEY=

# Supabase personal access token (sbp_...) — used ONLY by scripts/db.mjs to apply
# SQL migrations to the remote project via the Management API. Not used at runtime.
SUPABASE_ACCESS_TOKEN=
